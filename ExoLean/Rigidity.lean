import ExoLean.Degeneracies

/-!
# Multi-absorber identifiability: reduction to "power rigidity", and a counterexample

With several absorbers, whether `H` is identifiable becomes a pure-mathematics question about
the **opacity cone** `{Σᵢ aᵢ σᵢ + c : aᵢ, c ≥ 0}`. If two parameter sets give the same spectrum,
then `κ'(λ) = C · κ(λ)^{H/H'}`, so one cone element is a *power* of another.

* `PowerRigid σ S`: no non-constant cone element has a non-trivial power (`r ≠ 1`) that is
  proportional to a cone element on `S`.
* `Iso.scaleHeight_eq_of_powerRigid`: **reduction theorem.** Power rigidity implies `H` is
  identifiable whenever the spectrum is non-flat.
* `Iso.exists_powerRelated_twin`: **constructive counterexample.** If `σ₁ = σ₀^ρ` on the band,
  then "only absorber 0, at temperature `T`" and "only absorber 1, at temperature `T/ρ`" give
  identical spectra. The two cross-sections are distinct functions; the degeneracy comes from
  the multiplicative relation between them.
* `Iso.rayleigh_lambda8_twin`: the explicit instance `σ₀ = λ⁻⁴` (Rayleigh) and
  `σ₁ = λ⁻⁸`. A Rayleigh scatterer at `T` is spectrally identical to a `λ⁻⁸` absorber at
  `T/2`, and `not_powerRigid_rayleigh_lambda8` shows the pair is not power-rigid.
-/

noncomputable section

open Real

set_option linter.unusedSectionVars false

namespace ExoLean

variable {ι : Type*} [Fintype ι]

/-- The cone of admissible opacity functions generated by the cross-sections and a grey cloud. -/
def opacityCone (σ : ι → ℝ → ℝ) : Set (ℝ → ℝ) :=
  {κ | ∃ a : ι → ℝ, ∃ c : ℝ, (∀ i, 0 ≤ a i) ∧ 0 ≤ c ∧ ∀ w, κ w = ∑ i, a i * σ i w + c}

/-- **Power rigidity** of a family of cross-sections on a band `S`: if a positive power
`κ^r` (`r > 0`) of a non-constant cone element is proportional (`C > 0`) to a cone element on
`S`, then `r = 1`. The positivity of `r` and `C` is essential: with `r = 0`, any constant cloud
`κ' = C` would satisfy `κ' = C κ⁰` (see `not_powerRigidUnrestricted`). -/
def PowerRigid (σ : ι → ℝ → ℝ) (S : Set ℝ) : Prop :=
  ∀ κ ∈ opacityCone σ, ∀ κ' ∈ opacityCone σ, ∀ r C : ℝ, 0 < r → 0 < C →
    (∀ w ∈ S, 0 < κ w) → (∀ w ∈ S, κ' w = C * κ w ^ r) →
    (∃ w₁ ∈ S, ∃ w₂ ∈ S, κ w₁ ≠ κ w₂) → r = 1

namespace Iso

variable {p q : Iso ι}

theorem Valid.opacity_mem_cone (hp : p.Valid) (σ : ι → ℝ → ℝ) :
    p.opacity σ ∈ opacityCone σ :=
  ⟨p.absCoeff, p.κc, hp.absCoeff_nonneg, hp.κc_nonneg, fun _ => rfl⟩

/-- **Reduction theorem.** If the cross-sections are power-rigid on `S` and the spectrum is not
flat, equal spectra force equal scale heights. -/
theorem scaleHeight_eq_of_powerRigid {σ : ι → ℝ → ℝ} {S : Set ℝ} (hR : PowerRigid σ S)
    (hp : p.Valid) (hq : q.Valid) (hκp : ∀ w ∈ S, 0 < p.opacity σ w)
    (hκq : ∀ w ∈ S, 0 < q.opacity σ w)
    (hnc : ∃ w₁ ∈ S, ∃ w₂ ∈ S, p.opacity σ w₁ ≠ p.opacity σ w₂)
    (h : ∀ w ∈ S, p.transitRadius σ w = q.transitRadius σ w) : p.H = q.H := by
  have hHq := hq.H_pos
  have hr := hR (p.opacity σ) (hp.opacity_mem_cone σ) (q.opacity σ) (hq.opacity_mem_cone σ)
    (p.H / q.H) (exp ((p.level - q.level) / q.H)) (div_pos hp.H_pos hHq) (exp_pos _) hκp ?_ hnc
  · rwa [div_eq_one_iff_eq hHq.ne'] at hr
  intro w hw
  have hw' := h w hw
  rw [transitRadius_eq hp (hκp w hw), transitRadius_eq hq (hκq w hw)] at hw'
  have hlog : log (q.opacity σ w) = (p.level - q.level) / q.H + log (p.opacity σ w) * (p.H / q.H) := by
    field_simp
    linarith
  rw [rpow_def_of_pos (hκp w hw), ← exp_add, ← hlog, exp_log (hκq w hw)]

/-- **Constructive counterexample to "distinct cross-sections suffice".** If `σ₁ = σ₀^ρ` on the
band `S`, then a pure absorber-0 atmosphere at temperature `T` and a pure absorber-1 atmosphere
at temperature `T/ρ` (same `m`, `g`, `R0`; re-tuned `P0`) give identical spectra on `S`. -/
theorem exists_powerRelated_twin {σ : Fin 2 → ℝ → ℝ} {S : Set ℝ} {ρ : ℝ} (hρ : 0 < ρ)
    (hσ0 : ∀ w ∈ S, 0 < σ 0 w) (hσ1 : ∀ w ∈ S, σ 1 w = σ 0 w ^ ρ)
    {p : Iso (Fin 2)} (hp : p.Valid) (hX0 : 0 < p.X 0) (hX1 : p.X 1 = 0) (hκc : p.κc = 0) :
    ∃ q : Iso (Fin 2), q.Valid ∧ q.T = p.T / ρ ∧ q.X 0 = 0 ∧ q.X 1 = p.X 0 ∧ q.κc = 0 ∧
      q.m = p.m ∧ q.g = p.g ∧ q.R0 = p.R0 ∧
      ∀ w ∈ S, q.transitRadius σ w = p.transitRadius σ w := by
  set p' : Iso (Fin 2) := { p with T := p.T / ρ, X := ![0, p.X 0] }
  have hp' : p'.Valid := ⟨div_pos hp.T_pos hρ, hp.m_pos, hp.g_pos, hp.R0_pos, hp.P0_pos,
    fun i => by fin_cases i <;> simp [p', hX0.le], hp.κc_nonneg⟩
  have hH' : p'.H = p.H / ρ := by simp only [p', H]; field_simp
  set a := p.absCoeff 0
  have ha : 0 < a := div_pos hX0 hp.m_pos
  obtain ⟨P0', hP0', hL⟩ := exists_P0_level hp' (p.level + p.H * log a - p'.H * log a)
  set q : Iso (Fin 2) := { p' with P0 := P0' }
  have hq : q.Valid := ⟨hp'.T_pos, hp.m_pos, hp.g_pos, hp.R0_pos, hP0', hp'.X_nonneg, hp.κc_nonneg⟩
  refine ⟨q, hq, rfl, rfl, rfl, hκc, rfl, rfl, rfl, fun w hw => ?_⟩
  have hs := hσ0 w hw
  have hOp : p.opacity σ w = a * σ 0 w := by
    simp [opacity, Fin.sum_univ_two, absCoeff, hX1, hκc, a]
  have hOq : q.opacity σ w = a * σ 0 w ^ ρ := by
    simp [q, p', opacity, Fin.sum_univ_two, absCoeff, hκc, a, hσ1 w hw]
  have hpos_p : 0 < p.opacity σ w := by rw [hOp]; positivity
  have hpos_q : 0 < q.opacity σ w := by rw [hOq]; positivity
  rw [transitRadius_eq hq hpos_q, transitRadius_eq hp hpos_p, hOq, hOp, hL,
    show q.H = p'.H from rfl, hH', log_mul ha.ne' (rpow_pos_of_pos hs ρ).ne', log_rpow hs,
    log_mul ha.ne' hs.ne']
  field_simp
  ring

/-- The pair `(λ⁻⁴, λ⁻⁸)` is **not** power-rigid on `λ > 0`, although the two functions are
distinct. -/
theorem not_powerRigid_rayleigh_lambda8 :
    ¬ PowerRigid (fun i : Fin 2 => fun w : ℝ => w ^ (if i = 0 then (-4 : ℝ) else -8))
      (Set.Ioi 0) := by
  intro hR
  have h := hR (fun w => w ^ (-4 : ℝ)) ⟨![1, 0], 0, fun i => by fin_cases i <;> simp, le_rfl,
      fun w => by simp [Fin.sum_univ_two]⟩
    (fun w => w ^ (-8 : ℝ)) ⟨![0, 1], 0, fun i => by fin_cases i <;> simp, le_rfl,
      fun w => by simp [Fin.sum_univ_two]⟩
    2 1 two_pos one_pos (fun w hw => rpow_pos_of_pos hw _)
    (fun w hw => by
      simp only [one_mul]
      rw [← rpow_mul (le_of_lt hw)]
      norm_num)
    ⟨1, by norm_num, 2, by norm_num, by
      simp only [one_rpow]
      exact (rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num)).ne'⟩
  norm_num at h

/-- **Explicit instance:** a pure Rayleigh scatterer (`σ₀ = λ⁻⁴`) at temperature `T` and a pure
`λ⁻⁸` absorber at temperature `T/2` have identical analytic transmission spectra at every
wavelength. -/
theorem rayleigh_lambda8_twin {p : Iso (Fin 2)} (hp : p.Valid) (hX0 : 0 < p.X 0)
    (hX1 : p.X 1 = 0) (hκc : p.κc = 0) :
    ∃ q : Iso (Fin 2), q.Valid ∧ q.T = p.T / 2 ∧ q.X 0 = 0 ∧ q.X 1 = p.X 0 ∧
      ∀ w, 0 < w →
        q.transitRadius (fun i w => w ^ (if i = 0 then (-4 : ℝ) else -8)) w =
        p.transitRadius (fun i w => w ^ (if i = 0 then (-4 : ℝ) else -8)) w := by
  obtain ⟨q, hq, hT, hq0, hq1, -, -, -, -, h⟩ :=
    exists_powerRelated_twin (σ := fun i w => w ^ (if i = 0 then (-4 : ℝ) else -8))
      (S := Set.Ioi 0) (ρ := 2) two_pos (fun w hw => by simpa using rpow_pos_of_pos hw (-4))
      (fun w hw => by
        simp only [Fin.isValue, Fin.one_eq_zero_iff, OfNat.ofNat_ne_one, ite_false, ite_true]
        rw [← rpow_mul (le_of_lt hw)]
        norm_num)
      hp hX0 hX1 hκc
  exact ⟨q, hq, hT, hq0, hq1, fun w hw => h w hw⟩

end Iso

end ExoLean
